package views

import (
	"fmt"
	"emprendimientos.com/servidor-go/db/sqlc"
)

// PublicacionForm renderiza el formulario clásico (POST /publicaciones) para crear una publicación.
templ PublicacionForm() {
	<section class="bloque-formulario">
		<article>
			<h3>Nueva Publicación</h3>
			<form method="POST" action="/publicaciones">
				<div class="grid">
					<label>
						ID Emprendimiento *
						<input type="number" name="id_emprendimiento" placeholder="Ej: 1" min="1" required/>
					</label>
					<label>
						Título *
						<input type="text" name="titulo" placeholder="Ej: Promo 2x1 en Cafés" required/>
					</label>
				</div>
				<div class="grid">
					<label>
						Tipo *
						<select name="tipo" required>
							<option value="producto">Producto</option>
							<option value="promocion">Promoción</option>
							<option value="servicio">Servicio</option>
							<option value="otro">Otro</option>
						</select>
					</label>
					<label>
						Precio (opcional)
						<input type="number" step="0.01" min="0" name="precio" placeholder="Ej: 1500.00"/>
					</label>
				</div>
				<label>
					Contenido
					<input type="text" name="contenido" placeholder="Detalle de la publicación..."/>
				</label>
				<label>
					URL de Imagen
					<input type="url" name="imagen_url" placeholder="https://ejemplo.com/imagen.jpg"/>
				</label>
				<button type="submit" class="btn-principal">Crear Publicación</button>
			</form>
		</article>
	</section>
}

// PublicacionList recibe el slice tipado de publicaciones y renderiza la tabla con los datos
// controlando los campos sql.NullString (Precio, Contenido) y el caso de lista vacía.
templ PublicacionList(pubs []sqlc.Publicacione) {
	<section class="bloque-listado">
		<article>
			<h3>Listado de Publicaciones</h3>
			<figure>
				<table role="grid">
					<thead>
						<tr>
							<th scope="col">ID</th>
							<th scope="col">Título</th>
							<th scope="col">Tipo</th>
							<th scope="col">ID Emprendimiento</th>
							<th scope="col">Contenido</th>
							<th scope="col">Precio</th>
						</tr>
					</thead>
					<tbody>
						if len(pubs) == 0 {
							<tr>
								<td colspan="6" style="text-align: center;">No hay publicaciones registradas</td>
							</tr>
						} else {
							for _, p := range pubs {
								<tr>
									<td>{ fmt.Sprint(p.IDPublicacion) }</td>
									<td><strong>{ p.Titulo }</strong></td>
									<td>
										switch p.Tipo {
											case "producto":
												<span class="badge badge-producto">{ p.Tipo }</span>
											case "promocion":
												<span class="badge badge-promocion">{ p.Tipo }</span>
											case "servicio":
												<span class="badge badge-servicio">{ p.Tipo }</span>
											default:
												<span class="badge badge-otro">{ p.Tipo }</span>
										}
									</td>
									<td>{ fmt.Sprint(p.IDEmprendimiento) }</td>
									<td>
										if p.Contenido.Valid && p.Contenido.String != "" {
											{ p.Contenido.String }
										} else {
											<span>-</span>
										}
									</td>
									<td>
										if p.Precio.Valid && p.Precio.String != "" {
											<span class="badge badge-precio">${ p.Precio.String }</span>
										} else {
											<span>-</span>
										}
									</td>
								</tr>
							}
						}
					</tbody>
				</table>
			</figure>
		</article>
	</section>
}

// PublicacionesPage compone Layout, PublicacionForm y PublicacionList.
templ PublicacionesPage(pubs []sqlc.Publicacione) {
	@Layout("Publicaciones") {
		<h2>Gestión de Publicaciones</h2>
		<div class="layout-principal">
			@PublicacionForm()
			@PublicacionList(pubs)
		</div>
	}
}
