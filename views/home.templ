package views

// HomePage es la página de inicio del Portal de Emprendimientos.
templ HomePage() {
	@Layout("Inicio") {
		<section class="bloque-formulario">
			<article>
				<h1 style="border-left: none; padding-left: 0;">Bienvenido al Portal de Emprendimientos</h1>
				<p>Red centralizada de emprendimientos en Tandil. Conectamos clientes con productos y servicios locales.</p>
			</article>
		</section>
		<section class="bloque-listado">
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.5rem;">

				<article style="display: flex; flex-direction: column; align-items: center; text-align: center;">
					<img src="/static/images/emprendimiento.png" alt="Emprendimientos" style="width: 60px; margin-bottom: 1rem;"/>
					<h3>Emprendimientos</h3>
					<p style="flex: 1; margin-bottom: 1.5rem;">Registrá y explorá los emprendimientos de la red local.</p>
					<a href="/emprendimientos" class="btn-principal" style="display: inline-block; margin-top: auto; text-decoration: none; font-size: 0.9rem;">Ver Emprendimientos</a>
				</article>

				<article style="display: flex; flex-direction: column; align-items: center; text-align: center;">
					<img src="/static/images/usuario.png" alt="Usuarios" style="width: 60px; margin-bottom: 1rem;"/>
					<h3>Usuarios</h3>
					<p style="flex: 1; margin-bottom: 1.5rem;">Gestioná los usuarios registrados en la plataforma.</p>
					<a href="/usuarios" class="btn-principal" style="display: inline-block; margin-top: auto; text-decoration: none;">Ver Usuarios</a>
				</article>

				<article style="display: flex; flex-direction: column; align-items: center; text-align: center;">
					<img src="/static/images/publicacion.png" alt="Publicaciones" style="width: 60px; margin-bottom: 1rem;"/>
					<h3>Publicaciones</h3>
					<p style="flex: 1; margin-bottom: 1.5rem;">Explorá los productos, servicios y promociones publicadas.</p>
					<a href="/publicaciones" class="btn-principal" style="display: inline-block; margin-top: auto; text-decoration: none;">Ver Publicaciones</a>
				</article>

				<article style="display: flex; flex-direction: column; align-items: center; text-align: center;">
					<img src="/static/images/suscripcion.png" alt="Suscripciones" style="width: 60px; margin-bottom: 1rem;"/>
					<h3>Suscripciones</h3>
					<p style="flex: 1; margin-bottom: 1.5rem;">Elegí un usuario y suscribite a los emprendimientos locales.</p>
					<a href="/suscripciones" class="btn-principal" style="display: inline-block; margin-top: auto; text-decoration: none;">Ver Suscripciones</a>
				</article>

			</div>
		</section>
	}
}
