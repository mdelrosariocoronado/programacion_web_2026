package views

import (
	"fmt"
	"emprendimientos.com/servidor-go/internal/services"
)

// EmprendimientoForm renderiza el formulario clásico (POST /emprendimientos) para dar de alta un emprendimiento.
templ EmprendimientoForm() {
	<section class="bloque-formulario">
		<article>
			<div class="contenedor-h3">
				<h3>Nuevo Emprendimiento</h3>
			</div>
			
			<form method="POST" action="/emprendimientos">
				<div class="grid">
					<label>
						Nombre *
						<input type="text" name="nombre" placeholder="Ej: Cafetería Las Orquídeas" required/>
					</label>
					<label>
						Rubro *
						<input type="text" name="rubro" placeholder="Ej: Gastronomía" required/>
					</label>
				</div>
				<label>
					Descripción
					<input type="text" name="descripcion" placeholder="Breve descripción del emprendimiento"/>
				</label>
				<div class="grid">
					<label>
						Contacto
						<input type="text" name="contacto" placeholder="Teléfono, Instagram o email"/>
					</label>
					<label>
						Sitio Web (URL)
						<input type="url" name="url" placeholder="https://ejemplo.com"/>
					</label>
					<label>
						Logo (URL de imagen)
						<input type="text" name="logo" placeholder="https://ejemplo.com/logo.png"/>
					</label>
				</div>
				<button type="submit" class="btn-principal">Crear Emprendimiento</button>
			</form>
		</article>
	</section>
}

// EmprendimientoList recibe el slice tipado de emprendimientos y renderiza la tabla o un mensaje si está vacía.
templ EmprendimientoList(items []services.EmprendimientoResponse) {
	<section class="bloque-listado">
		<article>
			<h3>Listado de Emprendimientos</h3>
			if len(items) == 0 {
				<p>No hay emprendimientos registrados todavía.</p>
			} else {
				<figure>
					<table role="grid">
						<thead>
							<tr>
								<th scope="col">ID</th>
								<th scope="col">Nombre</th>
								<th scope="col">Rubro</th>
								<th scope="col">Descripción</th>
								<th scope="col">Contacto</th>
								<th scope="col">Web</th>
								<th scope="col">Activo</th>
							</tr>
						</thead>
						<tbody>
							for _, emp := range items {
								<tr>
									<td>{ fmt.Sprint(emp.IDEmprendimiento) }</td>
									<td><strong>{ emp.Nombre }</strong></td>
									<td><a class="badge badge-rubro">{ emp.Rubro }</a></td>
									<td>{ emp.Descripcion }</td>
									<td>{ emp.Contacto }</td>
									<td>
										if emp.Url != "" {
											<a href={ templ.SafeURL(emp.Url) } target="_blank" class="badge badge-destacado" style="text-decoration:none;">Visitar</a>
										} else {
											<a>-</a>
										}
									</td>
									<td>
										if emp.Activo {
											<a class="badge badge-activo">Sí</a>
										} else {
											<a class="badge badge-inactivo">No</a>
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				</figure>
			}
		</article>
	</section>
}

// EmprendimientosPage es el componente de página principal para Emprendimientos que compone Layout, Form y List.
templ EmprendimientosPage(items []services.EmprendimientoResponse) {
	@Layout("Emprendimientos") {
		<h2>Gestión de Emprendimientos</h2>
		<div class="layout-principal">
			@EmprendimientoForm()
			@EmprendimientoList(items)
		</div>
	}
}
